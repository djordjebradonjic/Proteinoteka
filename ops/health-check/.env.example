# Kopiraj ovaj fajl u .env (u istom folderu) i popuni pravim vrednostima.
# .env je u .gitignore — nikad ne commituj pravi fajl.

# Backend API (Railway)
PROD_API_URL=https://proteinoteka-production.up.railway.app

# Frontend domeni (RS i HR market)
SITE_URL_RS=https://proteinoteka.rs
SITE_URL_HR=https://proteinoteka.com.hr

# Admin token — isti kao ADMIN_TOKEN env var na backend-u (vidi CLAUDE.md / Railway env)
ADMIN_TOKEN=

# Produkcijska Postgres konekcija (Railway). Koristi se SAMO za SELECT upite.
DATABASE_URL=postgresql://postgres:PASSWORD@mainline.proxy.rlwy.net:16388/railway
